[delta]
	{{ mode }} = true
	syntax-theme = sbox
	minus-style = syntax "{{ background | mix: red, 15 }}"
	minus-non-emph-style = syntax "{{ background | mix: red, 15 }}"
	minus-emph-style = syntax "{{ background | mix: red, 32 }}"
	minus-empty-line-marker-style = syntax "{{ background | mix: red, 15 }}"
	line-numbers-minus-style = "{{ red }}"
	plus-style = syntax "{{ background | mix: green, 15 }}"
	plus-non-emph-style = syntax "{{ background | mix: green, 15 }}"
	plus-emph-style = syntax "{{ background | mix: green, 32 }}"
	plus-empty-line-marker-style = syntax "{{ background | mix: green, 15 }}"
	line-numbers-plus-style = "{{ green }}"
	line-numbers-zero-style = "{{ background | mix: foreground, 30 }}"
