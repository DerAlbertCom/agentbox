{
  "name": "sbox",
  "base": "{{ mode }}",
  "overrides": {
    "claude": "{{ accent }}",
    "claudeShimmer": "{{ accent | mix: foreground, 35 }}",
    "text": "{{ foreground }}",
    "inverseText": "{{ background }}",
    "inactive": "{{ foreground | mix: background, 40 }}",
    "inactiveShimmer": "{{ foreground | mix: background, 25 }}",
    "subtle": "{{ muted }}",
    "suggestion": "{{ cyan }}",
    "permission": "{{ blue }}",
    "permissionShimmer": "{{ blue | mix: foreground, 35 }}",
    "remember": "{{ yellow }}",
    "success": "{{ green }}",
    "error": "{{ red }}",
    "warning": "{{ yellow }}",
    "warningShimmer": "{{ yellow | mix: foreground, 35 }}",
    "merged": "{{ magenta }}",
    "promptBorder": "{{ accent }}",
    "promptBorderShimmer": "{{ accent | mix: foreground, 35 }}",
    "planMode": "{{ cyan }}",
    "autoAccept": "{{ yellow }}",
    "bashBorder": "{{ bright_yellow }}",
    "ide": "{{ bright_cyan }}",
    "diffAdded": "{{ background | mix: green, 15 }}",
    "diffRemoved": "{{ background | mix: red, 15 }}",
    "diffAddedDimmed": "{{ background | mix: green, 8 }}",
    "diffRemovedDimmed": "{{ background | mix: red, 8 }}",
    "diffAddedWord": "{{ background | mix: green, 32 }}",
    "diffRemovedWord": "{{ background | mix: red, 32 }}",
    "userMessageBackground": "{{ background | mix: foreground, 6 }}",
    "userMessageBackgroundHover": "{{ background | mix: foreground, 10 }}",
    "composerSidebarBackground": "{{ background | mix: foreground, 5 }}",
    "bashMessageBackgroundColor": "{{ background | mix: foreground, 6 }}",
    "memoryBackgroundColor": "{{ background | mix: foreground, 6 }}",
    "selectionBg": "{{ selection_background }}",
    "rate_limit_fill": "{{ accent }}",
    "rate_limit_empty": "{{ background | mix: foreground, 20 }}",
    "briefLabelYou": "{{ yellow }}",
    "briefLabelClaude": "{{ accent }}"
  }
}
