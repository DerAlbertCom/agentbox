{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": {
      "dark": "{{ accent }}",
      "light": "{{ accent }}"
    },
    "secondary": {
      "dark": "{{ magenta }}",
      "light": "{{ magenta }}"
    },
    "accent": {
      "dark": "{{ cyan }}",
      "light": "{{ cyan }}"
    },
    "error": {
      "dark": "{{ red }}",
      "light": "{{ red }}"
    },
    "warning": {
      "dark": "{{ yellow }}",
      "light": "{{ yellow }}"
    },
    "success": {
      "dark": "{{ green }}",
      "light": "{{ green }}"
    },
    "info": {
      "dark": "{{ blue }}",
      "light": "{{ blue }}"
    },
    "text": {
      "dark": "{{ foreground }}",
      "light": "{{ foreground }}"
    },
    "textMuted": {
      "dark": "{{ background | mix: foreground, 60 }}",
      "light": "{{ background | mix: foreground, 60 }}"
    },
    "background": {
      "dark": "{{ background }}",
      "light": "{{ background }}"
    },
    "backgroundPanel": {
      "dark": "{{ background | mix: foreground, 6 }}",
      "light": "{{ background | mix: foreground, 6 }}"
    },
    "backgroundElement": {
      "dark": "{{ background | mix: foreground, 10 }}",
      "light": "{{ background | mix: foreground, 10 }}"
    },
    "border": {
      "dark": "{{ background | mix: foreground, 30 }}",
      "light": "{{ background | mix: foreground, 30 }}"
    },
    "borderActive": {
      "dark": "{{ accent }}",
      "light": "{{ accent }}"
    },
    "borderSubtle": {
      "dark": "{{ background | mix: foreground, 20 }}",
      "light": "{{ background | mix: foreground, 20 }}"
    },
    "diffAdded": {
      "dark": "{{ green }}",
      "light": "{{ green }}"
    },
    "diffRemoved": {
      "dark": "{{ red }}",
      "light": "{{ red }}"
    },
    "diffContext": {
      "dark": "{{ background | mix: foreground, 60 }}",
      "light": "{{ background | mix: foreground, 60 }}"
    },
    "diffHunkHeader": {
      "dark": "{{ blue }}",
      "light": "{{ blue }}"
    },
    "diffHighlightAdded": {
      "dark": "{{ bright_green }}",
      "light": "{{ bright_green }}"
    },
    "diffHighlightRemoved": {
      "dark": "{{ bright_red }}",
      "light": "{{ bright_red }}"
    },
    "diffAddedBg": {
      "dark": "{{ background | mix: green, 15 }}",
      "light": "{{ background | mix: green, 15 }}"
    },
    "diffRemovedBg": {
      "dark": "{{ background | mix: red, 15 }}",
      "light": "{{ background | mix: red, 15 }}"
    },
    "diffContextBg": {
      "dark": "{{ background | mix: foreground, 6 }}",
      "light": "{{ background | mix: foreground, 6 }}"
    },
    "diffLineNumber": {
      "dark": "{{ background | mix: foreground, 60 }}",
      "light": "{{ background | mix: foreground, 60 }}"
    },
    "diffAddedLineNumberBg": {
      "dark": "{{ background | mix: green, 10 }}",
      "light": "{{ background | mix: green, 10 }}"
    },
    "diffRemovedLineNumberBg": {
      "dark": "{{ background | mix: red, 10 }}",
      "light": "{{ background | mix: red, 10 }}"
    },
    "markdownText": {
      "dark": "{{ foreground }}",
      "light": "{{ foreground }}"
    },
    "markdownHeading": {
      "dark": "{{ magenta }}",
      "light": "{{ magenta }}"
    },
    "markdownLink": {
      "dark": "{{ accent }}",
      "light": "{{ accent }}"
    },
    "markdownLinkText": {
      "dark": "{{ cyan }}",
      "light": "{{ cyan }}"
    },
    "markdownCode": {
      "dark": "{{ green }}",
      "light": "{{ green }}"
    },
    "markdownBlockQuote": {
      "dark": "{{ yellow }}",
      "light": "{{ yellow }}"
    },
    "markdownEmph": {
      "dark": "{{ yellow }}",
      "light": "{{ yellow }}"
    },
    "markdownStrong": {
      "dark": "{{ orange }}",
      "light": "{{ orange }}"
    },
    "markdownHorizontalRule": {
      "dark": "{{ muted }}",
      "light": "{{ muted }}"
    },
    "markdownListItem": {
      "dark": "{{ accent }}",
      "light": "{{ accent }}"
    },
    "markdownListEnumeration": {
      "dark": "{{ cyan }}",
      "light": "{{ cyan }}"
    },
    "markdownImage": {
      "dark": "{{ accent }}",
      "light": "{{ accent }}"
    },
    "markdownImageText": {
      "dark": "{{ cyan }}",
      "light": "{{ cyan }}"
    },
    "markdownCodeBlock": {
      "dark": "{{ foreground }}",
      "light": "{{ foreground }}"
    },
    "syntaxComment": {
      "dark": "{{ background | mix: foreground, 55 }}",
      "light": "{{ background | mix: foreground, 55 }}"
    },
    "syntaxKeyword": {
      "dark": "{{ magenta }}",
      "light": "{{ magenta }}"
    },
    "syntaxFunction": {
      "dark": "{{ blue }}",
      "light": "{{ blue }}"
    },
    "syntaxVariable": {
      "dark": "{{ foreground }}",
      "light": "{{ foreground }}"
    },
    "syntaxString": {
      "dark": "{{ green }}",
      "light": "{{ green }}"
    },
    "syntaxNumber": {
      "dark": "{{ orange }}",
      "light": "{{ orange }}"
    },
    "syntaxType": {
      "dark": "{{ yellow }}",
      "light": "{{ yellow }}"
    },
    "syntaxOperator": {
      "dark": "{{ cyan }}",
      "light": "{{ cyan }}"
    },
    "syntaxPunctuation": {
      "dark": "{{ background | mix: foreground, 75 }}",
      "light": "{{ background | mix: foreground, 75 }}"
    }
  }
}
