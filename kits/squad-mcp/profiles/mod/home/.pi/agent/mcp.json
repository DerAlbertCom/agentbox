{
  "mcpServers": {
    "aws-localhost-gateway": {
      "url": "${MCP_GATEWAY_URL}"
    },
    "context7": {
      "url": "${MCP_CONTEXT7_URL}"
    },
    "ado": {
      "command": "mcp-server-azuredevops",
      "args": [
        "${ADO_ORGANIZATION}",
        "--authentication",
        "pat",
        "-d",
        "core",
        "repositories",
        "pipelines",
        "wiki",
        "work-items",
        "search"
      ],
      "env": {
        "PERSONAL_ACCESS_TOKEN": "${AZURE_DEVOPS_EXT_PAT}"
      }
    },
    "elastic-nprod": {
      "url": "${MCP_ELASTIC_NPROD_URL}",
      "exposure": "hidden",
      "toolExposure": {
        "observability_*": "codemode",
        "platform_core_list_indices": "codemode",
        "platform_core_index_explorer": "codemode",
        "platform_core_get_index_mapping": "codemode",
        "platform_core_generate_esql": "codemode",
        "platform_core_execute_esql": "codemode"
      }
    },
    "elastic-prod": {
      "url": "${MCP_ELASTIC_PROD_URL}",
      "exposure": "hidden",
      "toolExposure": {
        "observability_*": "codemode",
        "platform_core_list_indices": "codemode",
        "platform_core_index_explorer": "codemode",
        "platform_core_get_index_mapping": "codemode",
        "platform_core_generate_esql": "codemode",
        "platform_core_execute_esql": "codemode"
      }
    }
  }
}
