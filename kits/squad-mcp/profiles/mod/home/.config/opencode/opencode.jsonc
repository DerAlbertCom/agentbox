{
  "$schema": "https://opencode.ai/config.json",
  "worktree": {
    "directory": "~/worktrees"
  },
  "agents": {
    "build": {
      "model": "github-copilot/gpt-6.1-sol#medium"
    },
    "plan": {
      "model": "github-copilot/gpt-6.1-sol#medium"
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "elastic-nprod_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "elastic-nprod_observability_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-nprod_platform_core_list_indices",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-nprod_platform_core_index_explorer",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-nprod_platform_core_get_index_mapping",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-nprod_platform_core_generate_esql",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-nprod_platform_core_execute_esql",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-prod_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "elastic-prod_observability_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-prod_platform_core_list_indices",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-prod_platform_core_index_explorer",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-prod_platform_core_get_index_mapping",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-prod_platform_core_generate_esql",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "elastic-prod_platform_core_execute_esql",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "aws-localhost-gateway": {
        "type": "remote",
        "url": "{env:MCP_GATEWAY_URL}",
        "codemode": false
      },
      "context7": {
        "type": "remote",
        "url": "${MCP_CONTEXT7_URL}",
        "oauth": false
      },
      "ado": {
        "type": "local",
        "command": [
          "mcp-server-azuredevops",
          "${ADO_ORGANIZATION}",
          "--authentication",
          "pat",
          "-d",
          "core",
          "repositories",
          "pipelines",
          "wiki",
          "work-items",
          "search"
        ],
        "environment": {
          "PERSONAL_ACCESS_TOKEN": "{env:AZURE_DEVOPS_EXT_PAT}"
        }
      },
      "elastic-nprod": {
        "type": "remote",
        "url": "${MCP_ELASTIC_NPROD_URL}",
        "oauth": false
      },
      "elastic-prod": {
        "type": "remote",
        "url": "${MCP_ELASTIC_PROD_URL}",
        "oauth": false
      }
    }
  }
}
