{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "github-copilot/claude-sonnet-5.5",
  "agents": {
    "title": {
      "model": "github-copilot/gpt-5.4-mini"
    }
  },
  "providers": {
    "github-copilot": {
      "settings": {
        "baseURL": "https://copilot-api.rwe.ghe.com",
        "apiKey": "{env:RWE_GHE_TOKEN}"
      },
      "models": {
        "claude-opus-5.5": {
          "settings": {
            "baseURL": "https://copilot-api.rwe.ghe.com/v1"
          },
          "headers": {
            "Copilot-Integration-Id": "vscode-chat"
          },
          "compatibility": {
            "supportsThinkingBlockBinding": false
          }
        },
