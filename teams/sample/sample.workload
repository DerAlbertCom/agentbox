# The base image of the CAPE team.
#
# The workload becomes a sandbox kit: abox writes the descriptor and the Dockerfile
# from these lines. Of several versions of a tool, the last one is the active one.
template: docker.io/sbx/shell-docker-image
publishRepository: mtiae-developer-container-images-local

apt:
  - ca-certificates
  - curl
  - gnupg
  - software-properties-common
  - unzip
  - libsecret-1-0
  - build-essential
  - file
  - git
  - pkg-config
  - libncurses-dev
  - libreadline-dev
  - libpcre2-dev
  - openssh-server
  - gettext-base

# abox installs the tools in this order: runtimes come before the tools that need them.
mise:
  - nodejs@24.22.2
  - bun@1.4.4
  - npm:@anthropic-ai/claude-code[allow_builds=true]@2.1.326
  - npm:@github/copilot[allow_builds=true]@1.0.112
  - npm:@earendil-works/pi-coding-agent[allow_builds=true]@1.5.2
  - npm:@opencode/cli[allow_builds=true]@2.3.0
  - dotnet@9.0.303
  - dotnet@10.0.403

scripts:
  - enable-fzf.sh
