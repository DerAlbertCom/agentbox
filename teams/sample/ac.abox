# The AC squad: the base image of the team, with the kits and the tools of the squad.
base: cape

kits:
  - github-enterprise-auth
  - pi-config
  - opencode-config
  - elastic-auth

# Named values the kits and the MCP servers use.
parameters:
  elastic-url: https://foobar.com/mcp

# The MCP servers every agent of the sandbox gets.
mcp:
  - name: elastic
    url: ${{ parameters.elastic-url }}
  - azuredevops

# The directories that survive a replacement of the sandbox.
state:
  - ~/.config/opencode/state
  - ~/.local/state/shell

# The secrets of the host: the kits ask for a service, this says how its value is
# obtained. abox keeps the values with 'sbx secret', so they never enter the sandbox.
secrets:
  # A service sbx knows: the token is asked for and stored under its name.
  - service: github
    prompt: The GitHub token for GitHub Enterprise Cloud

  # A service sbx does not know: the host and the variable the agents read.
  - service: elastic
    host: api.elastic.co
    env: ELASTIC_API_KEY
    prompt: The API key for Elastic
