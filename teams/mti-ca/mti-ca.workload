# The base image of the mti-ca team.
#
# The workload becomes a sandbox kit: abox writes the descriptor and the Dockerfile
# from these lines. The last tool of the list is the default of the image.
template: docker.io/sbx/shell-docker-image

# The latest dotnet 10 SDK at the time of writing (2026-11). Pin it by hand when a
# newer one comes out.
mise:
  - dotnet@10.0.403
