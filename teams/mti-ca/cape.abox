base: base
kits:
  - name: squad-mcp
    args:
      MCP_PROFILE: cape
      MCP_DATABASE_URL: ${{ parameters.database-url }}
      MCP_ELASTIC_URL: ${{ parameters.elastic-url }}
  - cape-database-mcp
  - name: jfrog
    args:
      JFROG_FEED: ${{ parameters.jfrog-feed }}
  - clean-code-mcp
  - cape-elastic
  - host-access-cape
  - name: azure-devops-project
    args:
      ADO_ORGANIZATION: ${{ parameters.ado-organization }}
      ADO_PROJECT: ${{ parameters.ado-project }}
      ADO_NUGET_FEED: ${{ parameters.ado-nuget-feed }}
parameters:
  ado-organization: RWEST-MFI-AE
  ado-project: CS
  ado-nuget-feed: rwest-cs
  jfrog-feed: mtiae-cs-nuget-prod
  database-url: https://dev.cape.rwe.com/mcp
  elastic-url: https://675962b701c243adb707252f420dc1c2.eu-central-1.aws.cloud.es.io/api/agent_builder/mcp
secrets:
  - service: cape-database-mcp
    prompt: CAPE database MCP API key
  - service: cape-elastic
    prompt: CAPE Elastic encoded API key
  - service: jfrog
    inputs:
      - name: username
      - name: token
    encoding: base64
