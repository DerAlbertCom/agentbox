<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile
      Include="../../../cli/src/Abox/**/*.cs"
      Exclude="../../../cli/src/Abox/Program.cs;../../../cli/src/Abox/obj/**/*.cs;../../../cli/src/Abox/bin/**/*.cs"
    />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
