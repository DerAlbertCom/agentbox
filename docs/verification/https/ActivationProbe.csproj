<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile
      Include="../../../cli/src/Abox/**/*.cs"
      Exclude="../../../cli/src/Abox/Program.cs;../../../cli/src/Abox/obj/**/*.cs;../../../cli/src/Abox/bin/**/*.cs"
    />
    <Compile Include="../../agents/story-3-certificate-probe/SbxClient.Probe.cs" />
    <EmbeddedResource
      Include="../../../cli/src/Abox/Sbx/development_certificate.py"
      LogicalName="Abox.DevelopmentCertificateReceiver"
    />
    <EmbeddedResource
      Include="../../../cli/src/Abox/Sbx/development_certificate_exec.sh"
      LogicalName="Abox.DevelopmentCertificateExec"
    />
    <EmbeddedResource
      Include="../../../cli/src/Abox/Sbx/development_certificate_trust.py"
      LogicalName="Abox.DevelopmentCertificateTrust"
    />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
