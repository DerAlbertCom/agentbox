{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "synthetic": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist/synthetic",
            "optimization": false,
            "sourceMap": true
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "synthetic:build",
            "port": 8354
          },
          "configurations": {
            "same": { "port": 8354 },
            "preview": { "port": 8355 }
          }
        }
      }
    }
  }
}
